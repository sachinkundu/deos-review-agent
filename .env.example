# GitHub App credentials — copy to .env and fill in. Never commit real values.

# GitHub App ID (Settings -> your GitHub App -> "App ID")
GITHUB_APP_ID=
# Installation ID for the account/repo the app is installed on
GITHUB_APP_INSTALLATION_ID=
# Path to the App private key (.pem)
GITHUB_APP_PRIVATE_KEY=/absolute/path/to/app-key.pem

# Optional: the app slug (bot username becomes "<slug>[bot]"). If unset it is
# derived at runtime from GET /app.
GITHUB_APP_SLUG=
# Optional: explicit bot username override (e.g. "review-bot[bot]")
GITHUB_APP_BOT_USERNAME=

# Workspace root for PR checkouts (default: ~/review-bot-workspaces)
REVIEW_WORKSPACE_ROOT=

# Agent driver (default: codex). Any CLI that `CodexAgentRunner` can drive.
REVIEW_AGENT_COMMAND=codex
# Optional model override for the agent driver
REVIEW_AGENT_MODEL=

# Timeouts in seconds
REVIEW_AGENT_TIMEOUT_SECONDS=1800
REVIEW_BOOTSTRAP_TIMEOUT_SECONDS=600
