# GitHub App credentials — copy to .env and fill in. Never commit real values.

# GitHub App ID (Settings -> your GitHub App -> "App ID")
GITHUB_APP_ID=
# Installation ID for the account/repo the app is installed on
GITHUB_APP_INSTALLATION_ID=
# Path to the App private key (.pem)
GITHUB_APP_PRIVATE_KEY=/absolute/path/to/app-key.pem

# Optional: the app slug (bot username becomes "<slug>[bot]"). If unset it is
# derived at runtime from GET /app.
GITHUB_APP_SLUG=
# Optional: explicit bot username override (e.g. "review-bot[bot]")
GITHUB_APP_BOT_USERNAME=

# Workspace root for PR checkouts (default: ~/review-bot-workspaces)
REVIEW_WORKSPACE_ROOT=

# Agent driver (default: pi).
# Supported: "pi" (recommended, uses the pi coding agent) or "codex".
REVIEW_AGENT_COMMAND=pi

# Optional model override. Examples:
#   REVIEW_AGENT_MODEL=hetzner/kimi-k2.7-code
#   REVIEW_AGENT_MODEL=openrouter/anthropic/claude-sonnet-latest
# Leave unset to use pi's default model.
REVIEW_AGENT_MODEL=

# Optional thinking level for the agent (off, minimal, low, medium, high,
# xhigh, max). Defaults to high.
REVIEW_AGENT_THINKING=high

# Per-agent overrides (optional). If unset, falls back to REVIEW_AGENT_THINKING.
# REVIEW_CORRECTNESS_THINKING=high
# REVIEW_API_REALITY_THINKING=high
# REVIEW_COORDINATOR_THINKING=high

# Timeouts in seconds
REVIEW_AGENT_TIMEOUT_SECONDS=1800
REVIEW_BOOTSTRAP_TIMEOUT_SECONDS=600
